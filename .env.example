# Job Search Tool configuration. run.sh copies this file to .env on first run.
# Blank values use the documented default. See README.md "Configuration".

# --- Codex CLI (the first two are also editable in the app's Configuration panel)
# Executable: "codex" on PATH, or an absolute path to an executable named codex
CODEX_CLI_PATH=codex
# Blank = the Codex CLI default model
CODEX_MODEL=
# Seconds allowed for each Codex invocation
CODEX_CLI_TIMEOUT_SECONDS=270
# 1 enables Codex scoring (editable in the UI)
JOB_SEARCH_ENABLE_GPT_SCORING=0
# 1 replays successful captured responses; 0 forces live requests (editable in the UI)
JOB_SEARCH_USE_CAPTURE_CACHE=1

# --- Web server
JOB_SEARCH_HOST=127.0.0.1
JOB_SEARCH_PORT=5050
# Set to 1 only to bind a non-loopback JOB_SEARCH_HOST (the API is unauthenticated)
JOB_SEARCH_ALLOW_REMOTE=0
# Comma-separated Host header values to accept; blank = 127.0.0.1:<port>,localhost:<port>
JOB_SEARCH_ALLOWED_HOSTS=
# 1 enables Flask debug mode (refused on non-loopback hosts)
JOB_SEARCH_DEBUG=0
# Largest accepted HTTP request body in bytes
JOB_SEARCH_MAX_REQUEST_BYTES=1048576

# --- Scheduled search
# Ignored for now: scheduled searches are disabled in code (TASKS.md T-33).
JOB_SEARCH_AUTORUN=0
# Seconds between scheduled searches (ignored while the scheduler is disabled)
JOB_SEARCH_INTERVAL_SECONDS=86400

# --- Workspace and profile
# Directory holding career-manual/, resume/, applications/; blank = parent of job-search-tool/
JOB_SEARCH_WORKSPACE_ROOT=
# Search profile JSON; blank = <workspace>/job-search-profile.json, else profile.example.json
JOB_SEARCH_PROFILE_PATH=

# --- Paths (blank = defaults; app paths resolve against job-search-tool/,
# document paths against the workspace root)
JOB_SEARCH_DB_PATH=
JOB_SEARCH_LOG_DIR=
JOB_SEARCH_CAPTURE_DIR=
JOB_SEARCH_GUIDANCE_PATH=
JOB_SEARCH_CAREER_MANUAL_PATH=
JOB_SEARCH_MASTER_RESUME_PATH=

# --- Timeouts and limits
JOB_SEARCH_HTTP_TIMEOUT_SECONDS=30
# Largest job-board/posting response read, in bytes
JOB_SEARCH_HTTP_MAX_RESPONSE_BYTES=5242880
JOB_SEARCH_DB_TIMEOUT_SECONDS=30
# Seconds allowed for each Pandoc DOCX conversion
PANDOC_TIMEOUT_SECONDS=120
# Finished bulk tasks kept in memory for polling
JOB_SEARCH_MAX_RETAINED_TASKS=50
# Background tasks (search, scoring, packets) allowed to run at once
JOB_SEARCH_MAX_RUNNING_TASKS=2

# --- Logs
JOB_SEARCH_LOG_MAX_BYTES=1048576
JOB_SEARCH_LOG_BACKUP_COUNT=5
