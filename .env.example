CODEX_CLI_PATH=codex
CODEX_MODEL=
JOB_SEARCH_HOST=127.0.0.1
JOB_SEARCH_PORT=5050
# Set to 1 only to bind a non-loopback JOB_SEARCH_HOST (the API is unauthenticated)
JOB_SEARCH_ALLOW_REMOTE=0
# Comma-separated Host header values to accept; blank = 127.0.0.1:<port>,localhost:<port>
JOB_SEARCH_ALLOWED_HOSTS=
JOB_SEARCH_AUTORUN=1
JOB_SEARCH_ENABLE_GPT_SCORING=0
JOB_SEARCH_USE_CAPTURE_CACHE=1
# Largest accepted HTTP request body in bytes
JOB_SEARCH_MAX_REQUEST_BYTES=1048576
# Largest job-board/posting response read, in bytes
JOB_SEARCH_HTTP_MAX_RESPONSE_BYTES=5242880
JOB_SEARCH_LOG_MAX_BYTES=1048576
JOB_SEARCH_LOG_BACKUP_COUNT=5
